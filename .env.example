DATABASE_URL="postgresql://caxe:caxe_dev_password@localhost:5432/caxe_dev"
AUTH_SECRET="change-me"

# Paiement (Stripe). Sans STRIPE_SECRET_KEY : mode démonstration en développement, « indisponible » en production.
# PAIEMENT_MODE="demonstration" force la démonstration (aucun paiement réel, accès offert) : à ne jamais définir en production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Adresse publique du site, pour les retours de paiement.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# "1" pour que Stripe ajoute la TVA (Stripe Tax doit être configuré dans le tableau de bord Stripe).
STRIPE_TAX_AUTOMATIQUE=""
PAIEMENT_MODE=""

# Recherche des références de marché (agent de recherche).
ANTHROPIC_API_KEY=""

# E-mails (lien « Mot de passe oublié »). Serveur SMTP du fournisseur choisi (Brevo, Mailjet, OVH, Resend…).
# Sans SMTP_HOST : mode démonstration en développement (le message est écrit dans .emails-demonstration/,
# rien ne part), aucun envoi en production. EMAIL_MODE="demonstration" force la démonstration (environnement de test).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Adresse qui envoie, par exemple « CAXE <contact@votre-domaine.fr> ».
EMAIL_EXPEDITEUR=""
EMAIL_MODE=""
